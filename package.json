{
  "name": "scentday-price-checker",
  "version": "0.1.0",
  "private": true,
  "description": "ScentDay fragrance price comparison — retailer registry and offer presentation core",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "affiliate:status": "tsx scripts/affiliate-status.ts",
    "shipping:staleness": "tsx scripts/shipping-staleness.ts",
    "demo": "tsc -p tsconfig.demo.json && esbuild dist-demo/demo/app.js --bundle --format=iife --minify --target=es2020 --outfile=dist-demo/bundle.js && tsx scripts/build-demo.ts",
    "catalogue": "tsx scripts/catalogue-run.ts",
    "catalogue:fixtures": "tsx scripts/catalogue-fixtures.ts",
    "catalogue:demo": "tsx scripts/build-demo-catalogue.ts",
    "probe": "tsx scripts/catalogue-probe.ts",
    "harvest": "tsx scripts/catalogue-harvest.ts",
    "catalogue:feed": "tsx scripts/catalogue-feed.ts",
    "images:check": "tsx scripts/image-link-check.ts",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "undici": "^8.9.0"
  }
}
