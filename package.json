{
  "name": "pricesniffs-price-checker",
  "version": "3.1.0",
  "private": true,
  "description": "PriceSniffs fragrance price comparison — retailer registry and offer presentation core",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsx scripts/ensure-demo-built.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "tests:count": "tsx scripts/count-tests.ts",
    "affiliate:status": "tsx scripts/affiliate-status.ts",
    "shipping:staleness": "tsx scripts/shipping-staleness.ts",
    "shipping:confidence": "tsx scripts/shipping-confidence-report.ts",
    "shipping:discover": "tsx scripts/shipping-discover.ts",
    "delivery:recheck": "tsx scripts/delivery-recheck.ts",
    "alerts:send": "tsx scripts/price-alerts.ts",
    "match:report": "tsx scripts/match-report.ts",
    "duplicates": "tsx scripts/find-duplicates.ts",
    "sets-oils:report": "tsx scripts/sets-oils-report.ts",
    "demo": "tsc -p tsconfig.demo.json && tsx scripts/bundle-demo.ts && tsx scripts/build-demo.ts && tsx scripts/build-sitemap.ts",
    "catalogue": "tsx scripts/catalogue-run.ts",
    "catalogue:fixtures": "tsx scripts/catalogue-fixtures.ts",
    "catalogue:demo": "tsx scripts/build-demo-catalogue.ts",
    "catalogue:history": "tsx scripts/build-price-history.ts",
    "deals:build": "tsx scripts/build-deals.ts",
    "rebuild": "npm run catalogue:demo && npm run deals:build && npm run catalogue:history && npm run demo",
    "probe": "tsx scripts/catalogue-probe.ts",
    "harvest": "tsx scripts/catalogue-harvest.ts",
    "houses": "tsx scripts/houses-harvest.ts",
    "repair:delist": "tsx scripts/repair-mass-delist.ts",
    "repair:mojibake": "tsx scripts/repair-mojibake-at-rest.ts",
    "catalogue:feed": "tsx scripts/catalogue-feed.ts",
    "notino:import": "tsx scripts/import-notino-pages.ts",
    "awin:feed-sync": "tsx scripts/awin-feed-sync.ts",
    "awin:feed-diag": "tsx scripts/awin-feed-diag.ts",
    "awin:memberships": "tsx scripts/awin-memberships.ts",
    "price:verify": "tsx scripts/price-verify.ts",
    "currency:probe": "tsx scripts/currency-probe.ts",
    "brand:probe": "tsx scripts/brand-site-probe.ts",
    "logo:probe": "tsx scripts/logo-probe.ts",
    "apify:blob-probe": "tsx scripts/apify-blob-probe.ts",
    "apify:state-probe": "tsx scripts/apify-state-probe.ts",
    "amazon:probe": "tsx scripts/amazon-probe.ts",
    "storefront:reprice": "tsx scripts/storefront-reprice.ts",
    "tiktok:probe": "tsx scripts/tiktok-probe.ts",
    "images:check": "tsx scripts/image-link-check.ts",
    "photos:coverage": "tsx scripts/photo-coverage.ts",
    "photos:better": "tsx scripts/better-photos.ts",
    "images:box-check": "tsx scripts/image-box-check.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "og:preview": "tsx scripts/generate-og-preview.ts",
    "screenshot": "tsx scripts/screenshot.ts",
    "a11y": "tsx scripts/a11y-audit.ts",
    "perf:load": "tsx scripts/measure-load.ts",
    "perf:images": "tsx scripts/measure-images.ts",
    "perf:filters": "tsx scripts/measure-filters.ts",
    "changelog:suggest": "tsx scripts/changelog-suggest.ts",
    "quarantine:prices": "tsx scripts/quarantine-prices.ts",
    "sitemap": "tsx scripts/build-sitemap.ts",
    "social:render": "tsx scripts/render-social.ts",
    "links:resolve": "tsx scripts/resolve-fragrance-links.ts",
    "social:deal": "tsx scripts/social-deal-of-day.ts",
    "social:savings": "tsx scripts/social-savings.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.1.2",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "undici": "^8.9.0"
  }
}
