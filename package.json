{
  "name": "pricesniffs-price-checker",
  "version": "3.1.0",
  "private": true,
  "description": "PriceSniffs fragrance price comparison — retailer registry and offer presentation core",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "affiliate:status": "tsx scripts/affiliate-status.ts",
    "shipping:staleness": "tsx scripts/shipping-staleness.ts",
    "shipping:confidence": "tsx scripts/shipping-confidence-report.ts",
    "shipping:discover": "tsx scripts/shipping-discover.ts",
    "match:report": "tsx scripts/match-report.ts",
    "demo": "tsc -p tsconfig.demo.json && esbuild dist-demo/demo/app.js --bundle --format=iife --minify --target=es2020 --outfile=dist-demo/bundle.js && tsx scripts/build-demo.ts && tsx scripts/build-sitemap.ts",
    "catalogue": "tsx scripts/catalogue-run.ts",
    "catalogue:fixtures": "tsx scripts/catalogue-fixtures.ts",
    "catalogue:demo": "tsx scripts/build-demo-catalogue.ts",
    "catalogue:history": "tsx scripts/build-price-history.ts",
    "deals:build": "tsx scripts/build-deals.ts",
    "probe": "tsx scripts/catalogue-probe.ts",
    "harvest": "tsx scripts/catalogue-harvest.ts",
    "houses": "tsx scripts/houses-harvest.ts",
    "repair:delist": "tsx scripts/repair-mass-delist.ts",
    "repair:mojibake": "tsx scripts/repair-mojibake-at-rest.ts",
    "catalogue:feed": "tsx scripts/catalogue-feed.ts",
    "awin:feed-sync": "tsx scripts/awin-feed-sync.ts",
    "awin:feed-diag": "tsx scripts/awin-feed-diag.ts",
    "awin:memberships": "tsx scripts/awin-memberships.ts",
    "price:verify": "tsx scripts/price-verify.ts",
    "currency:probe": "tsx scripts/currency-probe.ts",
    "brand:probe": "tsx scripts/brand-site-probe.ts",
    "apify:blob-probe": "tsx scripts/apify-blob-probe.ts",
    "storefront:reprice": "tsx scripts/storefront-reprice.ts",
    "images:check": "tsx scripts/image-link-check.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "og:preview": "tsx scripts/generate-og-preview.ts",
    "changelog:suggest": "tsx scripts/changelog-suggest.ts",
    "quarantine:prices": "tsx scripts/quarantine-prices.ts",
    "sitemap": "tsx scripts/build-sitemap.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "undici": "^8.9.0"
  }
}
