{
  "name": "scentday-price-checker",
  "version": "0.1.0",
  "private": true,
  "description": "ScentDay fragrance price comparison — retailer registry and offer presentation core",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "affiliate:status": "tsx scripts/affiliate-status.ts",
    "shipping:staleness": "tsx scripts/shipping-staleness.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
