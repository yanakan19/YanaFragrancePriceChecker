{
  // The demo harness is the only part of the project that touches the DOM.
  // It gets its own config so the core stays DOM-free and portable to the
  // React Native client planned for Phase 6.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist-demo",
    "types": [],
    // Virtual Yanny's engine (demo/yanny/*.js) is plain JavaScript that
    // used to live in YanaFreeAPIMerger/server and run under tsx on a
    // server; it now ships inside this bundle. tsc copies it through to
    // dist-demo so esbuild can bundle it. It is not type-checked (no
    // checkJs): the TypeScript side reaches it only through
    // demo/virtualYanny.ts, which declares the few shapes it consumes.
    "allowJs": true
  },
  "include": ["src/**/*.ts", "demo/**/*.ts", "demo/yanny/*.js"],
  // The crawl runs on a server and reaches for node:fs. The browser bundle only
  // ever reads its output, so these never belong in it.
  "exclude": [
    "src/catalogue/store.ts",
    "src/catalogue/fetcher.ts",
    "src/catalogue/crawl.ts"
  ]
}
