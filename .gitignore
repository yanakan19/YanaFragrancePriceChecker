node_modules/
dist/
dist-demo/
# The published site, written by `npm run demo` and built at deploy time by
# .github/workflows/deploy-pages.yml; "deploy" in scripts/generated-files.txt.
# Committed until 2026-10-04, when its content-hashed data files were most of
# the repository's daily growth.
/demo/index.html
/demo/404.html
/demo/data/
/demo/sitemap.xml
/demo/ads.txt
# What a deployment was built from: written by deploy-pages.yml after the
# build (scripts/deploy-decision.mjs record), published, never committed.
/demo/build-state.json
coverage/
# `npm run screenshot` writes here by default. See scripts/screenshot.ts: these
# are megabytes each and go stale the moment the catalogue is harvested again.
screenshots/
# scripts/image-box-check.ts's downloaded-photo cache: retailer images it
# fetched to classify, never the project's to redistribute or commit.
.image-box-cache/
*.log
# Python's own bytecode cache. scripts/image-box-classify.py is invoked as a
# subprocess by scripts/image-box-check.ts, and CPython writes a .pyc beside it
# on the first call — a machine- and version-specific build artefact of a file
# already in the repo, so there is nothing here to commit.
__pycache__/
*.pyc
.env
.env.*
!.env.example
.DS_Store

# .claude holds per-agent worktrees, which are throwaway, alongside the session
# hook, which has to be in the repo to reach a future session at all. Listed as
# .claude/* rather than .claude/ so git still descends and can see the two
# un-ignored entries — it does not look inside a directory it has excluded.
.claude/*
!.claude/settings.json
!.claude/hooks/

social/posts/*/_frames/

# Pages the owner saved by hand for scripts/catalogue-import-pages.ts: whole
# shop pages (large, and the shop's own copy). The import reads them and the
# snapshot it writes is what gets committed. See docs/OWNER-STEPS.md.
/data/manual-pages/
