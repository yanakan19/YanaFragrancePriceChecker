node_modules/
dist/
dist-demo/
# The published site, written by `npm run demo` and built at deploy time by
# .github/workflows/deploy-pages.yml; "deploy" in scripts/generated-files.txt.
# Committed until 2026-10-04, when its content-hashed data files were most of
# the repository's daily growth.
/demo/index.html
/demo/404.html
/demo/data/
/demo/sitemap.xml
/demo/sitemap-*.xml
/demo/ads.txt
# The region pages (public beta since 2026-10-09): /us/ and /in/, each with its own
# page, data files and route pages, built at deploy time like the UK's.
/demo/us/
/demo/in/
# The note icons under content-hashed names (scripts/noteData.ts); the drawn
# sources beside them in demo/note-icons/ are committed.
/demo/note-icons/h/
# A page of its own for each fixed address (scripts/build-route-pages.ts): /about is
# demo/about.html, /about/legal is demo/about/legal.html. The template is source.
/demo/*.html
!/demo/template.html
/demo/about/
/demo/legal/
/demo/account/
/demo/guides/
# What a deployment was built from: written by deploy-pages.yml after the
# build (scripts/deploy-decision.mjs record), published, never committed.
/demo/build-state.json
coverage/
# Pages the owner saves from notino.co.uk (docs/OWNER-STEPS.md). Raw pages can
# hold account details, so they are never committed; scripts/import-notino-pages.ts
# keeps product facts only.
/data/notino-inbox/
# `npm run screenshot` writes here by default. See scripts/screenshot.ts: these
# are megabytes each and go stale the moment the catalogue is harvested again.
screenshots/
# scripts/image-box-check.ts's downloaded-photo cache: retailer images it
# fetched to classify, never the project's to redistribute or commit.
.image-box-cache/
*.log
# Python's own bytecode cache. scripts/image-box-classify.py is invoked as a
# subprocess by scripts/image-box-check.ts, and CPython writes a .pyc beside it
# on the first call — a machine- and version-specific build artefact of a file
# already in the repo, so there is nothing here to commit.
__pycache__/
*.pyc
.env
.env.*
!.env.example
.DS_Store

# .claude holds per-agent worktrees, which are throwaway, alongside the session
# hook, which has to be in the repo to reach a future session at all. Listed as
# .claude/* rather than .claude/ so git still descends and can see the two
# un-ignored entries — it does not look inside a directory it has excluded.
.claude/*
!.claude/settings.json
!.claude/hooks/

social/posts/*/_frames/
# Scratch work and the sample Guess the Fragrance puzzles (a puzzle's check.json holds the answer: never committed).
/social/_today/
# A social post's pictures and videos: "social" in scripts/generated-files.txt
# (docs/DECISIONS.md D28, 2026-10-08). Drawn from the post's committed text with
# `npm run social:render -- social/posts/<folder>`, and by
# .github/workflows/social-pictures.yml into a private workflow artifact.
/social/**/*.png
/social/**/*.jpg
/social/**/*.jpeg
/social/**/*.webp
/social/**/*.gif
/social/**/*.mp4
/social/**/*.mov
/social/**/*.webm
